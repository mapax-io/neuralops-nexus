# Copy to neuralops/infra.env and fill in real values. Gitignored via the
# repo's existing `*.env` pattern in .gitignore -- the filename ends in
# ".env" on purpose so that pattern actually catches it (a name like
# "env.infra" would NOT have matched -- double check this if you ever
# rename it). Holds the external plumbing: how the three app services
# (nucleus/nexus-ai/centrifugo) reach postgres/redis/chroma, plus which
# profile runs and which host ports get used.
#
# Run with BOTH env files explicitly — do NOT rely on Compose auto-loading
# the repo's existing .env here, that file belongs to docker-compose.yaml
# and sets COMPOSE_PROFILES=dev for ITS OWN dev/fat profiles, which would
# collide with this file's profile names (dev/production) if picked up by
# accident:
#
#   docker compose -f docker-compose.neuralops.yaml \
#     --env-file neuralops/infra.env --env-file neuralops/app.env up -d

# CRITICAL: Compose scopes containers/networks/volumes by PROJECT NAME,
# which defaults to the current directory name -- NOT by which -f file you
# pass. This directory already has docker-compose.yaml (the old dev/fat
# stack) in it, and this new stack reuses several of its service names
# (nucleus-dev, nexus-ai-dev, redis-dev, postgres-dev, chromadb-dev,
# nginx-dev, ...) for internal-DNS convenience. Without an explicit,
# DIFFERENT project name here, Compose treats both files as the SAME
# project and RECREATES the old stack's running containers to match this
# file's definitions the moment you run `up` -- which is exactly what
# happened the first time this was tested. This line is what prevents that
# from ever happening again -- do not remove it.
COMPOSE_PROJECT_NAME=neuralops

# production is the default profile -- a bare `docker compose -f
# docker-compose.neuralops.yaml --env-file ... up -d` with no --profile flag
# pulls prebuilt images, no source tree needed. Use `--profile dev` (or
# change this line) to build locally instead.
COMPOSE_PROFILES=production

# =========================================================
# The neuralops image itself (production profile only -- dev builds locally).
# Version-pinned, not :latest -- matches every other image reference in this
# repo (noamanfaisal/neuralops-nucleus:${FAT_VERSION:-0.1.1}, etc.). 0.2.0
# here matches the baked NEURALOPS_VERSION in neuralops/Dockerfile and
# COMPATIBLE_SERVER_VERSION in modules/neuralops-web-app/src/lib/version.ts
# -- there's no separate repo-root VERSION file anymore (removed), so these
# three are the only places this number lives; keep all three in sync
# whenever this version bumps.
# =========================================================
NEURALOPS_IMAGE=noamanfaisal/neuralops:0.2.0

# =========================================================
# Database -- shared by nucleus, nucleus-celery, nucleus-celery-beat, and
# the postgres container's own first-boot init (official postgres image
# reads POSTGRES_DB/USER/PASSWORD itself to create the role/database).
#
# POSTGRES_DB/POSTGRES_USER are plain identifiers, not secrets -- the
# defaults below are fine to leave as-is. Changing them is a minor, optional
# extra hardening step (mainly useful against automated scanners that assume
# default names) -- it is NOT a substitute for keeping POSTGRES_HOST_PORT
# off the public internet, which is what actually matters.
#
# POSTGRES_PASSWORD is intentionally NOT set here. It's a real
# per-deployment secret, now generated by `init-secrets` (see
# neuralops/entrypoint.sh) alongside FIELD_ENCRYPTION_KEY/INTERNAL_API_KEY/
# CENTRIFUGO_API_KEY/CENTRIFUGO_HMAC_SECRET, and lands in
# neuralops/secrets.env instead of here -- so every deployment gets a
# unique password instead of everyone who copies this example file sharing
# the same one.
# =========================================================
POSTGRES_DB=neuralops
POSTGRES_USER=neuralops

# =========================================================
# Host ports -- optional, shown here at their defaults. Deliberately
# different from docker-compose.yaml's dev (8081/5433/6379/8000) and fat
# (8090/5440/6390/8010) ports so all three stacks can run side by side on
# the same machine without colliding, if you ever need to compare them.
# =========================================================
# NGINX_HOST_PORT=8095
# POSTGRES_HOST_PORT=5495
# REDIS_HOST_PORT=6395
# NEXUS_AI_HOST_PORT=8020
# DEV_NGINX_HOST_PORT=8096
# DEV_POSTGRES_HOST_PORT=5496
# DEV_REDIS_HOST_PORT=6396
# DEV_NEXUS_AI_HOST_PORT=8021
