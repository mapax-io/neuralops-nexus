# Copy to neuralops/app.env. Gitignored via the same `*.env` pattern as
# neuralops/infra.env.
#
# Almost everything that used to live here is now baked directly into the
# neuralops image instead (FIELD_ENCRYPTION_KEY, INTERNAL_API_KEY,
# CENTRIFUGO_API_KEY/HMAC_SECRET, SUPABASE_URL/ANON_KEY/SERVICE_KEY,
# NEURALOPS_INSTALL_TOKEN, NEURALOPS_PORTAL_URL, NEURALOPS_VERSION — see the
# ENV block in neuralops/Dockerfile) — one shared default, same for every
# deployment, per explicit instruction. A future nucleus-side command will
# let a user regenerate their own unique set instead of the shared default
# (tracked separately, deferred, not built yet).
#
# There is deliberately no OPENAI_API_KEY / ANTHROPIC_API_KEY anywhere in
# this scheme — no shared default exists for those, ever, and they're not a
# deployment-level env var in this app's real design. Add AI models via
# nucleus's own /add-model flow after the server is up; each model's key is
# stored encrypted per-row in the database, not read from the environment.
#
# nucleus and centrifugo both load THIS FILE directly via docker-compose.
# neuralops.yaml's env_file: key (production profile) -- not through ${VAR}
# interpolation -- so these values get picked up at container-creation time
# regardless of which --env-file flags anyone types on the `up` command
# line. Dev profile is unchanged (still ${VAR} interpolation) -- tracked
# separately.

# =========================================================
# The one thing that's genuinely different per deployment and can't have a
# shared default: the public URL THIS box is reachable at. Get this wrong
# and login / Centrifugo will silently fail for anyone connecting from
# another machine.
# =========================================================
NEURALOPS_SERVER_URL=http://localhost:8095

# =========================================================
# Centrifugo (the realtime service) reads its allowed-origins config under
# ITS OWN variable name, CENTRIFUGO_ALLOWED_ORIGINS -- not
# NEURALOPS_SERVER_URL. Since centrifugo loads this file directly (env_file:,
# see docker-compose.neuralops.yaml), there's no ${VAR}-style renaming
# available to derive one from the other automatically -- set this by hand,
# to the SAME value as NEURALOPS_SERVER_URL above, and keep both in sync
# whenever either one changes.
# =========================================================
CENTRIFUGO_ALLOWED_ORIGINS=http://localhost:8095

# =========================================================
# Supabase identity project (optional). The image bakes the shared platform
# project; set these to verify sign-ins against your own project instead --
# the web app must then use the same project. SUPABASE_SERVICE_KEY is the
# project's service_role key (a full-admin secret): with it set, inviting a
# new address also emails the invitee; without it the inviter passes the
# steps on.
# =========================================================
#SUPABASE_URL=https://your-project.supabase.co
#SUPABASE_ANON_KEY=
#SUPABASE_SERVICE_KEY=

# =========================================================
# Already baked into neuralops/Dockerfile -- listed here for reference only,
# NOT settable from this file. docker-compose.neuralops.yaml doesn't
# reference any of these, that's what lets the image's baked-in default
# actually win; putting a value here would silently do nothing. To override
# one for a specific deployment today, add an explicit `- VAR=value` line
# back to that service's `environment:` block in docker-compose.neuralops.yaml
# directly -- a real per-deployment override path through this file is what
# the deferred regenerate command is for.
# =========================================================
#   SUPABASE_URL            = https://xgfsxikypxjhqlutiepw.supabase.co
#   SUPABASE_ANON_KEY       = (see neuralops/Dockerfile -- public by design, safe to expose)
#   SUPABASE_SERVICE_KEY    = (see neuralops/Dockerfile -- real secret, not shown twice here)
#   FIELD_ENCRYPTION_KEY    = (see neuralops/Dockerfile -- real secret, not shown twice here)
#   INTERNAL_API_KEY        = (see neuralops/Dockerfile -- real secret, not shown twice here)
#   CENTRIFUGO_API_KEY      = (see neuralops/Dockerfile -- real secret, not shown twice here)
#   CENTRIFUGO_HMAC_SECRET  = (see neuralops/Dockerfile -- real secret, not shown twice here)
#   NEURALOPS_INSTALL_TOKEN = gonzalo-academic-header-pastime
#   NEURALOPS_PORTAL_URL    = https://neuralops-nexus-demo.mapax.io
#   NEURALOPS_VERSION       = 0.1.2

# =========================================================
# Optional, has a default -- override here if you want a different one.
# =========================================================
# EMBEDDING_PROVIDER=fastembed
# EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
# EMBEDDING_BASE_URL=
