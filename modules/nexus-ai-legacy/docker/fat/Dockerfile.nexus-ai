# Fat profile image (#170) — source baked in, no bind mount, no --reload.
# Built from the same module as docker/dev/Dockerfile.nexus-ai, but this one
# ships as a versioned image on Docker Hub for self-host distribution.
# Build context is ./modules/nexus-ai (same as dev) — see docker-compose.yaml.
#
# Build + push (until a CI pipeline exists, run by hand):
#   docker build -t noamanfaisal/neuralops-nexus-ai:<version> \
#     -f docker/fat/Dockerfile.nexus-ai .
#   docker push noamanfaisal/neuralops-nexus-ai:<version>

# Stage 1: Build dependencies
FROM python:3.11-slim as builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

ENV VIRTUAL_ENV=/opt/venv/nexus-env
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

COPY docker/dev/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Stage 2: Final runtime — lean, source baked in, no dev tools/sudo
FROM python:3.11-slim

RUN set -eux; \
    apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    # openssh-client -- see docker/dev/Dockerfile.nexus-ai for why: stdio
    # MCP servers (e.g. Filesystem's ssh command) are spawned as direct
    # subprocesses of this container, not a separate one.
    openssh-client \
    curl; \
    adduser --disabled-password --gecos '' neuralops; \
    mkdir -p /nexus-ai; \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder --chown=neuralops:neuralops /opt/venv/nexus-env /opt/venv/nexus-env
COPY --chown=neuralops:neuralops . /nexus-ai

ENV VIRTUAL_ENV=/opt/venv/nexus-env
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
ENV PYTHONPATH=/nexus-ai

WORKDIR /nexus-ai
USER neuralops

EXPOSE 8000

# No --reload, fixed worker count — production-style entrypoint, not the dev
# hot-reload one.
CMD ["uvicorn", "apps.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
